# Host ports exposed by Docker Compose.
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=55432
KAFKA_PORT=9092

# Browser origin permitted to call the ASP.NET Core API directly during local development.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL development database.
POSTGRES_DB=abadar
POSTGRES_USER=abadar
POSTGRES_PASSWORD=abadar_dev

# Kafka development broker and topic partitioning.
KAFKA_TOPIC_PARTITIONS=3

# JWT settings. Replace the signing key outside local development.
JWT_ISSUER=abadar-backend
JWT_AUDIENCE=abadar-web
JWT_SIGNING_KEY=abadar-development-signing-key-change-before-production-2026
JWT_LIFETIME_MINUTES=60
